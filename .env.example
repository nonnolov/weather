# ── Database ──────────────────────────────────────────────────────────────────
# Full PostgreSQL connection URL
DATABASE_URL=postgresql+asyncpg://weather_user:weather_pass@localhost:5432/weather_db

# Synchronous URL used only by Alembic migrations
DATABASE_URL_SYNC=postgresql+psycopg2://weather_user:weather_pass@localhost:5432/weather_db

# ── Application ───────────────────────────────────────────────────────────────
APP_ENV=development          # development | production
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ADMIN_API_KEY=replace-with-a-random-secret-at-least-32-characters

# ── Weather Providers ─────────────────────────────────────────────────────────
# Default provider used when none is specified per location
DEFAULT_PROVIDER=open_meteo

# Open-Meteo — free tier, no key required
# OPEN_METEO_BASE_URL=https://api.open-meteo.com/v1

# OpenWeatherMap (future provider)
# OPENWEATHERMAP_API_KEY=

# ── Geocoding ─────────────────────────────────────────────────────────────────
# ArcGIS provides the administrative hierarchy used by the GPS flow.
GEOCODER_PROVIDER=arcgis
GEOCODER_BASE_URL=https://geocode.arcgis.com/arcgis/rest/services/World/GeocodeServer
GEOCODER_USER_AGENT=weather-forecasting-system/1.0

# ── Ingestion ─────────────────────────────────────────────────────────────────
# How many days ahead to fetch (max depends on provider plan)
FORECAST_DAYS=7

# ── Production CORS ───────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000

# ── LINE Messaging API ────────────────────────────────────────────────────────
# Never commit real credentials.
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
# LINE Login channel ID used to verify LIFF ID tokens on the backend.
LINE_LOGIN_CHANNEL_ID=
# Comma-separated LINE user/group IDs for seed/test alerts only.
LINE_USER_IDS=
LINE_API_BASE_URL=https://api.line.me

# ── Frontend ──────────────────────────────────────────────────────────────────
# Optional during local demo; required for real LINE/LIFF identity.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_LIFF_ID=


# LINE signup is off until migration 0010 and the linked Weather OA/LIFF are verified.
# When true, only explicitly enrolled recipients are eligible for scheduled sends.
LINE_SUBSCRIPTIONS_ENABLED=false
LINE_OFFICIAL_ACCOUNT_ID=
