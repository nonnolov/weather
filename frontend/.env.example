# URL of the FastAPI backend. The NEXT_PUBLIC_ prefix exposes this setting to the browser.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000


# Same-origin backend proxy; use the local or deployed FastAPI origin.
API_BASE_URL=http://localhost:8000
# Public LIFF app ID. The linked Weather app needs openid/profile scopes.
# Never put a Messaging API access token or channel secret in frontend variables.
NEXT_PUBLIC_LIFF_ID=
